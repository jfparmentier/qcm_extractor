{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/qcm/schemas/golden-dataset.schema.json",
  "title": "Jeu de données de référence Phase 0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset_version",
    "scope",
    "documents",
    "cases"
  ],
  "$defs": {
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      },
      "description": "Boîte englobante normalisée dans le repère de la page, origine en haut à gauche. Les contraintes x+width<=1 et y+height<=1 sont contrôlées applicativement."
    },
    "page_region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page",
        "role",
        "bbox"
      ],
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "role": {
          "enum": [
            "question",
            "choices",
            "answer",
            "feedback",
            "essential_image",
            "decorative_image",
            "context"
          ]
        },
        "bbox": {
          "$ref": "#/$defs/bbox"
        }
      }
    },
    "provenanced_text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content",
        "origin"
      ],
      "properties": {
        "content": {
          "type": "string"
        },
        "origin": {
          "enum": [
            "explicit_in_document",
            "generated_by_model",
            "provided_by_user",
            "not_available"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "origin": {
                "const": "not_available"
              }
            }
          },
          "then": {
            "properties": {
              "content": {
                "maxLength": 0
              }
            }
          }
        }
      ]
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "content"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^choice-[A-Za-z0-9._-]+$"
        },
        "content": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "source_page",
        "bbox",
        "alt_text",
        "insertion_token"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^asset-[A-Za-z0-9._-]+$"
        },
        "role": {
          "enum": [
            "essential",
            "decorative"
          ]
        },
        "source_page": {
          "type": "integer",
          "minimum": 1
        },
        "bbox": {
          "$ref": "#/$defs/bbox"
        },
        "alt_text": {
          "type": "string"
        },
        "insertion_token": {
          "type": "string",
          "pattern": "^asset:[A-Za-z0-9._-]+$"
        }
      }
    }
  },
  "properties": {
    "dataset_version": {
      "const": "1.0.0"
    },
    "scope": {
      "type": "string"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "filename",
          "language",
          "document_type",
          "page_count"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "document_type": {
            "type": "string"
          },
          "page_count": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "document_id",
          "source_label",
          "mapping_fragment",
          "expected_question",
          "rationale"
        ],
        "properties": {
          "case_id": {
            "type": "string"
          },
          "document_id": {
            "type": "string"
          },
          "source_label": {
            "type": "string"
          },
          "mapping_fragment": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "temporary_id",
              "question_number",
              "question_pages",
              "answer_pages",
              "feedback_pages",
              "contains_essential_image",
              "question_type_hint",
              "page_regions",
              "confidence",
              "warnings"
            ],
            "properties": {
              "temporary_id": {
                "type": "string",
                "pattern": "^segment-[A-Za-z0-9._-]+$"
              },
              "question_number": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "question_pages": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "answer_pages": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "feedback_pages": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "contains_essential_image": {
                "type": "boolean"
              },
              "question_type_hint": {
                "enum": [
                  "single_choice",
                  "multiple_choice",
                  "true_false",
                  "unknown"
                ]
              },
              "page_regions": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/page_region"
                }
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "warnings": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              }
            }
          },
          "expected_question": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "segment_id",
              "type",
              "title",
              "content_format",
              "statement",
              "choices",
              "correct_choice_ids",
              "correct_answer_origin",
              "feedback",
              "images",
              "source_pages",
              "confidence",
              "warnings",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^q-[A-Za-z0-9._-]+$"
              },
              "segment_id": {
                "type": "string",
                "pattern": "^segment-[A-Za-z0-9._-]+$"
              },
              "type": {
                "enum": [
                  "single_choice",
                  "multiple_choice",
                  "true_false"
                ]
              },
              "title": {
                "$ref": "#/$defs/provenanced_text"
              },
              "content_format": {
                "const": "markdown-latex"
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "choices": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "$ref": "#/$defs/choice"
                }
              },
              "correct_choice_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^choice-[A-Za-z0-9._-]+$"
                }
              },
              "correct_answer_origin": {
                "enum": [
                  "explicit_in_document",
                  "inferred_by_model",
                  "provided_by_user",
                  "not_available"
                ]
              },
              "feedback": {
                "$ref": "#/$defs/provenanced_text"
              },
              "images": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/image"
                }
              },
              "source_pages": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "warnings": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "status": {
                "const": "draft"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "correct_answer_origin": {
                      "const": "not_available"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "correct_choice_ids": {
                      "maxItems": 0
                    }
                  }
                },
                "else": {
                  "properties": {
                    "correct_choice_ids": {
                      "minItems": 1
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "single_choice"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "correct_choice_ids": {
                      "maxItems": 1
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "true_false"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "choices": {
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "correct_choice_ids": {
                      "maxItems": 1
                    }
                  }
                }
              }
            ]
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    }
  }
}
