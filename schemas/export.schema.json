{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/qcm/schemas/export.schema.json",
  "title": "Archive JSON de QCM validés",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "content_format",
    "document",
    "questions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "content_format": {
      "const": "markdown-latex"
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "language",
        "source_filename",
        "source_sha256"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 16
        },
        "source_filename": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      },
      "description": "Boîte englobante normalisée dans le repère de la page, origine en haut à gauche. Les contraintes x+width<=1 et y+height<=1 sont contrôlées applicativement."
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "content"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^choice-[A-Za-z0-9._-]+$"
        },
        "content": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "path",
        "mime_type",
        "alt_text",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^asset-[A-Za-z0-9._-]+$"
        },
        "role": {
          "enum": [
            "essential",
            "decorative"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^assets/[A-Za-z0-9._/-]+\\.(png|webp|jpe?g)$"
        },
        "mime_type": {
          "enum": [
            "image/png",
            "image/webp",
            "image/jpeg"
          ]
        },
        "alt_text": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "page",
            "bbox"
          ],
          "properties": {
            "page": {
              "type": "integer",
              "minimum": 1
            },
            "bbox": {
              "$ref": "#/$defs/bbox"
            }
          }
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "title_origin",
        "statement",
        "choices",
        "correct_choice_ids",
        "correct_answer_origin",
        "feedback",
        "feedback_origin",
        "assets",
        "source_pages",
        "validation_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^q-[A-Za-z0-9._-]+$"
        },
        "type": {
          "enum": [
            "single_choice",
            "multiple_choice",
            "true_false"
          ]
        },
        "title": {
          "type": "string"
        },
        "title_origin": {
          "enum": [
            "explicit_in_document",
            "generated_by_model",
            "provided_by_user",
            "not_available"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/choice"
          }
        },
        "correct_choice_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^choice-[A-Za-z0-9._-]+$"
          }
        },
        "correct_answer_origin": {
          "enum": [
            "explicit_in_document",
            "inferred_by_model",
            "provided_by_user",
            "not_available"
          ]
        },
        "feedback": {
          "type": "string"
        },
        "feedback_origin": {
          "enum": [
            "explicit_in_document",
            "generated_by_model",
            "provided_by_user",
            "not_available"
          ]
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/asset"
          }
        },
        "source_pages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "validation_status": {
          "const": "validated"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "correct_answer_origin": {
                "const": "not_available"
              }
            }
          },
          "then": {
            "properties": {
              "correct_choice_ids": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "correct_choice_ids": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "single_choice"
              }
            }
          },
          "then": {
            "properties": {
              "correct_choice_ids": {
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "true_false"
              }
            }
          },
          "then": {
            "properties": {
              "choices": {
                "minItems": 2,
                "maxItems": 2
              },
              "correct_choice_ids": {
                "maxItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
